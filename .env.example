# Создайте файл .env из копии этого файла и замените значения переменных реальными данными
SECRET_KEY=my_SECRET_KEY # Ваш_SECRET_KEY
DEBUG=True

# Настройки Stripe
STRIPE_SECRET_KEY=my_STRIPE_SECRET_KEY # Ваш секретный ключ из личного кабинета Stripe

# Конфигурация базы данных
DB_NAME=my_data_base # Имя базы данных
DB_USER=username # Имя пользователя (например, postgres)
DB_PASSWORD=password # Пароль базы данных
DB_HOST=django_postgres # Имя контейнера БД из docker-compose
DB_PORT=5432 # Номер порта, который закреплен за PostgreSQL по умолчанию

# Данные почтового сервера
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=your_email@yandex.ru # Ваша яндекс-почта
EMAIL_HOST_PASSWORD=app_password # Ваш пароль приложения

# Настройки для Redis
REDIS_URL=redis://django_redis:6379/0 # Адрес по имени контейнера Redis из docker-compose
